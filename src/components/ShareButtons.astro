---
interface Props {
  title: string;
}

const { title } = Astro.props;

// Canonical absolute URL. `site` is set from PUBLIC_DOCS_SITE at build time,
// so preview builds still share the production URL.
const url = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const obsidianContent = encodeURIComponent(`[${title}](${url})`);

const socialTargets = [
  {
    label: "Share on X",
    href: `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`,
    icon: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
    bg: "#000000",
    fg: "#FFFFFF",
  },
  {
    label: "Share on Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`,
    icon: "M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z",
    bg: "#1877F2",
    fg: "#FFFFFF",
  },
  {
    label: "Share on LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`,
    icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    bg: "#0A66C2",
    fg: "#FFFFFF",
  },
];

const bookmarkTargets = [
  {
    label: "Obsidian",
    href: `obsidian://new?name=${encodedTitle}&content=${obsidianContent}`,
    external: false,
  },
  {
    label: "Raindrop",
    href: `https://app.raindrop.io/add?url=${encodedUrl}&title=${encodedTitle}`,
  },
  {
    label: "Pinboard",
    href: `https://pinboard.in/add?next=same&url=${encodedUrl}&title=${encodedTitle}`,
  },
];
---


<div class="share-block" data-share-block data-pagefind-ignore>
  <p class="share-label">// Share this page</p>
  <div class="share-row">
    <button
      type="button"
      class="share-action share-native"
      data-share-native
      data-share-title={title}
      data-share-url={url}
      aria-label="Share this page using your device"
      hidden
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z" />
      </svg>
      <span>Share</span>
    </button>

    {socialTargets.map((target) => (
      <a
        href={target.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={target.label}
        class="share-social"
        style={`--share-bg: ${target.bg}; --share-fg: ${target.fg};`}
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d={target.icon} />
        </svg>
      </a>
    ))}

    <span class="share-divider" aria-hidden="true"></span>

    {bookmarkTargets.map((target) => (
      <a
        href={target.href}
        target={target.external === false ? undefined : "_blank"}
        rel={target.external === false ? undefined : "noopener noreferrer"}
        class="share-action"
      >
        {target.label}
      </a>
    ))}

    <a
      href={`mailto:?subject=${encodedTitle}&body=${encodedUrl}`}
      class="share-action"
      aria-label="Share via email"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z" />
      </svg>
      <span>Email</span>
    </a>

    <button
      type="button"
      class="share-action"
      aria-label="Copy link to this page"
      data-share-copy={url}
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" />
      </svg>
      <span data-share-copy-label>Copy link</span>
    </button>
  </div>
  <p class="share-status" role="status" aria-live="polite" data-share-status></p>
</div>

<script>
  function legacyCopy(text: string) {
    const helper = document.createElement("textarea");
    helper.value = text;
    helper.setAttribute("readonly", "");
    helper.style.position = "fixed";
    helper.style.opacity = "0";
    document.body.appendChild(helper);
    helper.select();
    const ok = document.execCommand("copy");
    document.body.removeChild(helper);
    return ok;
  }

  async function copyText(text: string) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        // Fall through to the legacy path below.
      }
    }
    return legacyCopy(text);
  }

  document.querySelectorAll<HTMLElement>("[data-share-block]").forEach((block) => {
    const status = block.querySelector<HTMLElement>("[data-share-status]");
    const nativeBtn = block.querySelector<HTMLButtonElement>("[data-share-native]");
    const copyBtn = block.querySelector<HTMLButtonElement>("[data-share-copy]");
    const copyLabel = block.querySelector<HTMLElement>("[data-share-copy-label]");
    let statusTimer: number | undefined;

    function announce(message: string) {
      if (!status) return;
      status.textContent = message;
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => {
        status.textContent = "";
      }, 3000);
    }

    if (nativeBtn && typeof navigator.share === "function") {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener("click", async () => {
        const url = nativeBtn.dataset.shareUrl;
        const title = nativeBtn.dataset.shareTitle;
        if (!url) return;

        try {
          await navigator.share({ title, url });
        } catch (error) {
          // A dismissed share sheet is not an error worth reporting.
          if (error instanceof DOMException && error.name === "AbortError") return;
          if (await copyText(url)) announce("Link copied to clipboard");
        }
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        const url = copyBtn.dataset.shareCopy;
        if (!url) return;

        if (!(await copyText(url))) {
          announce("Could not copy the link");
          return;
        }

        if (copyLabel) copyLabel.textContent = "Copied";
        copyBtn.classList.add("is-copied");
        window.setTimeout(() => {
          if (copyLabel) copyLabel.textContent = "Copy link";
          copyBtn.classList.remove("is-copied");
        }, 2000);
      });
    }
  });
</script>
